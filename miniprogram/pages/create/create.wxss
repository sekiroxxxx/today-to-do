.page { padding: var(--spacing-md); padding-bottom: 80px; min-height: 100vh; }

/* 模块选择器 — 网格 */
.module-grid { display: flex; flex-wrap: wrap; gap: var(--spacing-sm); margin-bottom: var(--spacing-md); }
.module-card { flex: 1 1 calc(33% - var(--spacing-sm)); min-width: 80px; text-align: center; padding: var(--spacing-sm); border-radius: var(--radius-sm); border: 2px solid transparent; background: #fff; }
.module-card-icon { font-size: 20px; display: block; }
.module-card-name { font-size: var(--font-tag); color: var(--color-text-secondary); display: block; margin-top: 4px; }
.module-card--active { background: var(--color-primary-light); }

/* 表单 */
.form-card { background: #fff; border-radius: var(--radius-md); padding: var(--spacing-md); box-shadow: var(--shadow-card); margin-bottom: var(--spacing-md); }
.form-item { margin-bottom: var(--spacing-md); }
.form-label { font-size: var(--font-caption); color: var(--color-text-secondary); display: block; margin-bottom: 6px; }
.required { color: var(--color-danger); }
.form-input { background: var(--color-bg); border-radius: var(--radius-sm); padding: 10px var(--spacing-sm); font-size: var(--font-body); width: 100%; box-sizing: border-box; line-height: 1.5; min-height: 44px; }
.form-textarea { background: var(--color-bg); border-radius: var(--radius-sm); padding: 10px var(--spacing-sm); font-size: var(--font-body); width: 100%; height: 80px; box-sizing: border-box; line-height: 1.5; }
.form-hint { font-size: var(--font-tag); color: var(--color-text-hint); margin-top: 4px; display: block; }

/* 优先级 */
.priority-row { display: flex; gap: var(--spacing-sm); }
.priority-btn { flex: 1; text-align: center; padding: 10px; border-radius: var(--radius-round); font-size: var(--font-body); background: var(--color-bg); color: var(--color-text-secondary); }
.priority-btn--high { background: #FFF1F0; color: #CF1322; border: 1px solid #CF1322; }
.priority-btn--mid { background: #FFFBE6; color: #D48A00; border: 1px solid #D48A00; }
.priority-btn--low { background: #E6FFFB; color: #08979C; border: 1px solid #08979C; }

/* 重复规则 */
.repeat-options { display: flex; gap: var(--spacing-xs); margin-bottom: var(--spacing-sm); }
.repeat-option { flex: 1; text-align: center; padding: 8px; border-radius: var(--radius-round); font-size: var(--font-caption); background: var(--color-bg); color: var(--color-text-secondary); }
.repeat-option--active { background: var(--color-primary-light); color: var(--color-primary); border: 1px solid var(--color-primary); }
.weekday-row { display: flex; gap: var(--spacing-xs); }
.weekday-item { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--font-caption); background: var(--color-bg); color: var(--color-text-secondary); }
.weekday-item--active { background: var(--color-primary); color: #fff; }

/* 提交 */
.submit-btn { width: 100%; background: var(--color-primary); color: #fff; font-size: var(--font-body); border-radius: var(--radius-round); padding: 12px 0; margin-top: var(--spacing-sm); }
.submit-btn[disabled] { opacity: 0.5; }
