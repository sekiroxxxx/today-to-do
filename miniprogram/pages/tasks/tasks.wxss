.page { padding: var(--spacing-md); padding-bottom: 100px; min-height: 100vh; }

/* 切换 Tab */
.tab-row {
  display: flex; background: #fff; border-radius: var(--radius-round);
  padding: 4px; margin-bottom: var(--spacing-md);
}
.tab { flex: 1; text-align: center; padding: 8px; font-size: var(--font-body); border-radius: var(--radius-round); color: var(--color-text-secondary); }
.tab--active { background: var(--color-primary); color: #fff; }
.batch-btn { font-size: var(--font-caption); color: var(--color-primary); padding: 8px 12px; flex-shrink: 0; }

/* 分组 */
.section { margin-bottom: var(--spacing-md); }
.section-title { font-size: var(--font-body); font-weight: 600; margin-bottom: var(--spacing-sm); display: block; }
.pri-dot { font-size: 14px; }
.pri-dot--high { color: #CF1322; }   /* S 红 */
.pri-dot--mid { color: #D48A00; }    /* A 金 */
.pri-dot--low { color: #722ED1; }    /* B 紫 */

/* 任务卡片 — 极简两行 */
.task-card {
  background: #fff; border-radius: var(--radius-md); padding: var(--spacing-md);
  margin-bottom: var(--spacing-xs); box-shadow: var(--shadow-card);
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
}
.task-card--disabled { opacity: 0.5; }
.task-card--selectable { padding-left: var(--spacing-sm); }

/* 复选框 */
.checkbox {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
  border: 2px solid var(--color-border); display: flex;
  align-items: center; justify-content: center; font-size: 12px;
}
.checkbox--checked { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.task-body { flex: 1; min-width: 0; }
.task-title { font-size: var(--font-body); font-weight: 500; line-height: 1.4; display: block; }
.task-tagline { font-size: var(--font-tag); color: var(--color-text-hint); margin-top: 4px; }
.task-arrow { font-size: 20px; color: #CCC; flex-shrink: 0; margin-top: 2px; }
.task-disabled-tag { font-size: var(--font-tag); color: var(--color-text-hint); margin-left: auto; }

/* 已完成卡片 */
.task-card--completed { opacity: 0.7; display: flex; flex-wrap: wrap; align-items: center; }
.task-completed-tag { font-size: var(--font-tag); color: #52C41A; margin-left: auto; flex-shrink: 0; }
.completed-actions { width: 100%; display: flex; gap: 12px; margin-top: 10px; }
.redo-btn { font-size: var(--font-caption); color: var(--color-primary); padding: 4px 10px; border: 1px solid var(--color-primary); border-radius: 6px; }
.delete-btn { font-size: var(--font-caption); color: #FF4D4F; padding: 4px 10px; border: 1px solid #FF4D4F; border-radius: 6px; }

/* 悬浮按钮 */
.fab {
  position: fixed; bottom: 80px; right: 24px;
  width: 52px; height: 52px; border-radius: 50%;
  background: var(--color-primary); color: #fff;
  font-size: 28px; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 12px rgba(22,119,255,0.4); z-index: 10;
}

/* 批量操作底部栏 */
.batch-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: var(--spacing-md);
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.08); z-index: 11;
}
.batch-count { font-size: var(--font-body); color: var(--color-text-secondary); }
.batch-delete-btn {
  background: #FF4D4F; color: #fff; font-size: var(--font-caption);
  border-radius: var(--radius-round); padding: 8px 20px; border: none;
}
.batch-delete-btn[disabled] { opacity: 0.4; }
