<!-- 添加/编辑任务 -->
<view class="page">
  <view class="form-card">
    <!-- 标题 -->
    <view class="form-item">
      <text class="form-label">任务标题 <text class="required">*</text></text>
      <input class="form-input" placeholder="如：刷 LeetCode 三道题" value="{{form.title}}"
             data-field="title" bindinput="onInput" />
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="补充说明..." value="{{form.note}}"
             data-field="note" bindinput="onInput" />
    </view>

    <!-- 优先级 -->
    <view class="form-item">
      <text class="form-label">优先级</text>
      <view class="priority-row">
        <view class="priority-btn {{form.priority === 1 ? 'priority-btn--high' : ''}}"
              data-priority="1" bindtap="onPrioritySelect">高</view>
        <view class="priority-btn {{form.priority === 2 ? 'priority-btn--mid' : ''}}"
              data-priority="2" bindtap="onPrioritySelect">中</view>
        <view class="priority-btn {{form.priority === 3 ? 'priority-btn--low' : ''}}"
              data-priority="3" bindtap="onPrioritySelect">低</view>
      </view>
    </view>

    <!-- 预计耗时 -->
    <view class="form-item">
      <text class="form-label">预计耗时（分钟）</text>
      <input class="form-input" type="number" placeholder="如：60" value="{{form.estimatedMinutes}}"
             data-field="estimatedMinutes" bindinput="onInput" />
    </view>

    <!-- 截止日 -->
    <view class="form-item">
      <text class="form-label">截止日期</text>
      <picker mode="date" value="{{form.deadline}}" bindchange="onDeadlineChange">
        <view class="form-input">{{form.deadline || '选择日期'}}</view>
      </picker>
    </view>

    <!-- 重复规则 -->
    <view class="form-item">
      <text class="form-label">重复规则</text>
      <view class="repeat-options">
        <view class="repeat-option {{form.repeatType === 'none' ? 'repeat-option--active' : ''}}"
              data-type="none" bindtap="onRepeatTypeSelect">不重复</view>
        <view class="repeat-option {{form.repeatType === 'daily' ? 'repeat-option--active' : ''}}"
              data-type="daily" bindtap="onRepeatTypeSelect">每天</view>
        <view class="repeat-option {{form.repeatType === 'weekly' ? 'repeat-option--active' : ''}}"
              data-type="weekly" bindtap="onRepeatTypeSelect">每周</view>
      </view>

      <!-- 每周的星期选择 -->
      <view wx:if="{{form.repeatType === 'weekly'}}" class="weekday-row">
        <view
          wx:for="{{weekdays}}"
          wx:key="value"
          class="weekday-item {{form.repeatDays.indexOf(item.value) > -1 ? 'weekday-item--active' : ''}}"
          data-day="{{item.value}}"
          bindtap="onWeekdayToggle"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <button class="submit-btn" bindtap="onSubmit" disabled="{{saving}}">
    {{saving ? '保存中...' : (isEdit ? '保存修改' : '添加任务')}}
  </button>
</view>
