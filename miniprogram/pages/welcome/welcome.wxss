.page {
  height: 100vh; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: linear-gradient(160deg, #F0F5FF 0%, #FFFFFF 40%, #F5F0FF 100%);
}

/* 主体 */
.hero { display: flex; flex-direction: column; align-items: center; }
.hero-icon { font-size: 72px; margin-bottom: var(--spacing-lg); }
.logo { font-size: 32px; font-weight: 800; color: var(--color-text); letter-spacing: 2px; }
.slogan {
  font-size: var(--font-caption); color: var(--color-text-hint);
  margin-top: var(--spacing-sm);
}

/* 按钮区 */
.actions { position: absolute; bottom: 80px; left: 40px; right: 40px; display: flex; flex-direction: column; align-items: center; }

.btn-start {
  width: 100%; background: var(--color-primary); color: #fff;
  font-size: var(--font-title); font-weight: 600;
  border-radius: var(--radius-round); padding: 14px 0;
  box-shadow: 0 4px 16px rgba(22,119,255,0.4);
}
.btn-start[disabled] { opacity: 0.5; }

.btn-skip {
  margin-top: var(--spacing-lg); font-size: var(--font-caption);
  color: var(--color-text-hint); padding: var(--spacing-xs);
}
