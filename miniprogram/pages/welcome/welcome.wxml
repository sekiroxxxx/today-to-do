<!-- Welcome v1.1 -->
<view class="page" wx:if="{{!checking}}">
  <view class="hero">
    <view class="hero-icon">⚔️</view>
    <text class="logo">刷日常</text>
    <text class="slogan">每天上线，领取你的今日委托</text>
  </view>

  <view class="module-select">
    <text class="select-title">选择你的日常模块</text>
    <view wx:for="{{allModules}}" wx:key="key" class="check-item"
      data-key="{{item.key}}" bindtap="onModuleCheck">
      <view class="checkbox {{selected.indexOf(item.key) > -1 ? 'checkbox--checked' : ''}}"
        style="{{selected.indexOf(item.key) > -1 ? 'background:' + item.color + ';border-color:' + item.color : ''}}">
        <text wx:if="{{selected.indexOf(item.key) > -1}}">✓</text>
      </view>
      <text class="check-label">{{item.icon}} {{item.name}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-start" bindtap="onStart" disabled="{{starting}}">
      {{starting ? '加载中...' : '开始刷日常'}}
    </button>
    <text class="btn-skip" bindtap="onSkip">不是第一次？直接开始</text>
  </view>
</view>
