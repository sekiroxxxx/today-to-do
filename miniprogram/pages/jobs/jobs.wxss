.page { padding: var(--spacing-md); padding-bottom: 100px; min-height: 100vh; }

/* 漏斗看板 */
.funnel {
  display: flex; align-items: center; justify-content: space-around;
  background: var(--color-white); border-radius: var(--radius-md);
  padding: var(--spacing-md); margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}
.funnel-item { text-align: center; flex: 1; }
.funnel-num { font-size: 28px; font-weight: 700; display: block; }
.funnel-num--highlight { color: var(--color-primary); }
.funnel-label { font-size: var(--font-caption); color: var(--color-text-hint); margin-top: 4px; }
.funnel-arrow { color: var(--color-text-hint); font-size: var(--font-title); }

/* 工具栏 */
.toolbar { margin-bottom: var(--spacing-sm); }
.search-input {
  background: #fff; border-radius: var(--radius-sm); padding: 10px var(--spacing-sm);
  font-size: var(--font-body); margin-bottom: var(--spacing-xs);
}
.filter-scroll { white-space: nowrap; }
.filter-tags { display: flex; gap: var(--spacing-xs); padding: 4px 0; }
.filter-tag {
  display: inline-block; padding: 6px 16px; border-radius: var(--radius-round);
  background: #fff; font-size: var(--font-caption); color: var(--color-text-secondary);
  flex-shrink: 0;
}
.filter-tag--active { background: var(--color-primary); color: #fff; }

/* 岗位卡片 */
.job-list { display: flex; flex-direction: column; gap: var(--spacing-sm); }
.job-card {
  background: #fff; border-radius: var(--radius-md); padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

/* 第一行：公司名 + 状态标签（两端对齐） */
.job-row1 {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 4px;
}
.job-company { font-size: 16px; font-weight: 700; flex: 1; min-width: 0; }

/* 第二行：岗位名 */
.job-position {
  font-size: var(--font-caption); color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
}

/* 第三行：评分 + 推进按钮 */
.job-row3 { display: flex; align-items: flex-end; justify-content: space-between; }
.job-scores { display: flex; gap: var(--spacing-lg); }
.score-item { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
.score-text { font-size: var(--font-tag); color: var(--color-text-hint); }

/* 快速推进 */
.job-advance {
  display: flex; flex-direction: column; align-items: center;
  padding: 2px var(--spacing-sm); border-left: 1px solid var(--color-border);
  flex-shrink: 0;
}
.advance-icon { font-size: 20px; }
.advance-text { font-size: var(--font-tag); color: var(--color-text-hint); }

/* 悬浮按钮 */
.fab {
  position: fixed; bottom: 80px; right: 24px;
  width: 52px; height: 52px; border-radius: 50%;
  background: var(--color-primary); color: #fff;
  font-size: 28px; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 12px rgba(22,119,255,0.4); z-index: 10;
}
