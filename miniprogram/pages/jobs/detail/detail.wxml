<!-- 岗位详情 -->
<view class="page" wx:if="{{!loading && job}}">
  <!-- 头部信息 -->
  <view class="card">
    <view class="flex-between">
      <status-tag status="{{job.status}}" />
      <text class="edit-link" bindtap="onEdit">编辑</text>
    </view>
    <text class="detail-company">{{job.company}}</text>
    <text class="detail-position">{{job.position}}</text>
    <!-- 薪资 -->
    <view wx:if="{{job.salaryRange}}" class="detail-info-row">
      <text class="detail-info-label">💰 薪资范围</text>
      <text class="detail-info-value">{{job.salaryRange}}</text>
    </view>
    <!-- 投递链接（点击复制） -->
    <view wx:if="{{job.applyLink}}" class="detail-info-row detail-link" bindtap="onCopyLink" data-link="{{job.applyLink}}">
      <text class="detail-info-label">🔗 投递链接</text>
      <text class="detail-info-value detail-link-text">{{job.applyLink}}</text>
    </view>
    <!-- 截止日 -->
    <view wx:if="{{job.deadline}}" class="detail-info-row">
      <text class="detail-info-label">📅 截止日期</text>
      <text class="detail-info-value">{{job.deadline}}</text>
    </view>
  </view>

  <!-- 评分 -->
  <view class="card">
    <view class="flex-between" style="margin-bottom:12px">
      <view>
        <text class="score-label">吸引力</text>
        <star-rating value="{{job.attractionScore}}" readonly="{{true}}" size="md" />
      </view>
      <view>
        <text class="score-label">准备度</text>
        <star-rating value="{{job.preparednessScore}}" readonly="{{true}}" size="md" />
      </view>
    </view>
  </view>

  <!-- 状态时间轴 -->
  <view class="card">
    <text class="section-title">状态时间轴</text>
    <view class="timeline">
      <view wx:for="{{job.statusHistory}}" wx:key="index" class="timeline-item">
        <view class="timeline-dot {{index === 0 ? 'timeline-dot--active' : ''}}"></view>
        <view class="timeline-content">
          <text class="timeline-status">{{item.status}}</text>
          <text wx:if="{{item.note}}" class="timeline-note">{{item.note}}</text>
          <text class="timeline-time">{{item.time}}</text>
        </view>
      </view>
      <view wx:if="{{!job.statusHistory || job.statusHistory.length === 0}}" class="timeline-empty">
        暂无状态变更记录
      </view>
    </view>
  </view>
</view>

<!-- 底部操作区（固定底部） -->
<view class="actions-bar" wx:if="{{!loading && job}}">
  <!-- 推进状态：主按钮 -->
  <button class="btn-advance" bindtap="onAdvanceStatus" wx:if="{{job.status !== 'Offer' && job.status !== '已拒绝'}}">
    📤 推进状态
  </button>

  <!-- 已拒绝 + 删除：两个文字按钮 -->
  <view class="actions-sub" wx:if="{{job.status !== 'Offer' && job.status !== '已拒绝'}}">
    <text class="btn-text btn-text--reject" bindtap="onReject">已拒绝（放弃该岗位）</text>
    <text class="divider">｜</text>
    <text class="btn-text btn-text--delete" bindtap="onDelete">{{deleting ? '删除中...' : '删除'}}</text>
  </view>
  <!-- 终态只显示删除 -->
  <view class="actions-sub" wx:else>
    <text class="btn-text btn-text--delete" bindtap="onDelete">{{deleting ? '删除中...' : '删除'}}</text>
  </view>
</view>

<!-- ===== 推进状态弹窗 ===== -->
<action-sheet
  visible="{{showStatusSheet}}"
  title="推进状态"
  items="{{statusItems}}"
  bind:select="onStatusSelect"
  bind:close="onSheetClose"
/>

<!-- ===== 拒绝原因选择面板 ===== -->
<view class="reject-mask" wx:if="{{showRejectSheet}}" catchtap="closeRejectSheet"></view>
<view class="reject-panel {{showRejectSheet ? 'reject-panel--show' : ''}}">
  <view class="reject-title">该岗位为什么结束了？</view>
  <view wx:for="{{rejectReasons}}" wx:key="value" class="reject-item" catchtap="onRejectSelect" data-value="{{item.value}}" data-index="{{index}}">
    <view class="reject-radio {{selectedRejectReason === item.value ? 'reject-radio--active' : ''}}"></view>
    <text>{{item.label}}</text>
  </view>
  <!-- 其他原因输入 -->
  <view wx:if="{{selectedRejectReason === 'other'}}" style="margin-top: 8px">
    <input class="form-input" placeholder="请输入原因" value="{{customRejectReason}}" bindinput="onRejectReasonInput" />
  </view>
  <button class="btn-advance" style="margin-top:12px;width:100%" bindtap="onRejectConfirm">
    确认标记为已拒绝
  </button>
  <view class="sheet-cancel" bindtap="closeRejectSheet">取消</view>
</view>
