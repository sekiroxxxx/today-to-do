<!-- 添加/编辑岗位 -->
<view class="page">
  <view class="form-card">
    <!-- 公司名称 -->
    <view class="form-item">
      <text class="form-label">公司名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="如：字节跳动" value="{{form.company}}"
             data-field="company" bindinput="onInput" />
    </view>

    <!-- 岗位 -->
    <view class="form-item">
      <text class="form-label">岗位名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="如：前端开发工程师" value="{{form.position}}"
             data-field="position" bindinput="onInput" />
    </view>

    <!-- 薪资范围 -->
    <view class="form-item">
      <text class="form-label">薪资范围</text>
      <input class="form-input" placeholder="如：20k-35k 或 面议" value="{{form.salaryRange}}"
             data-field="salaryRange" bindinput="onInput" />
    </view>

    <!-- 投递链接 -->
    <view class="form-item">
      <text class="form-label">投递链接</text>
      <input class="form-input" placeholder="如：https://zhaopin.xxx.com" value="{{form.applyLink}}"
             data-field="applyLink" bindinput="onInput" />
    </view>

    <!-- 截止日 -->
    <view class="form-item">
      <text class="form-label">截止日期</text>
      <picker mode="date" value="{{form.deadline}}" bindchange="onDeadlineChange">
        <view class="form-input">{{form.deadline || '选择日期'}}</view>
      </picker>
    </view>

    <!-- 吸引力评分 -->
    <view class="form-item">
      <text class="form-label">吸引力评分</text>
      <view class="score-row">
        <star-rating value="{{form.attractionScore}}" size="lg" bind:change="onAttractionChange" />
        <text class="score-hint">{{form.attractionScore === 1 ? '随便试试' : form.attractionScore === 3 ? '比较想去' : form.attractionScore === 5 ? '梦寐以求' : ''}}</text>
      </view>
    </view>

    <!-- 准备度评分 -->
    <view class="form-item">
      <text class="form-label">准备度评分</text>
      <view class="score-row">
        <star-rating value="{{form.preparednessScore}}" size="lg" bind:change="onPreparednessChange" />
        <text class="score-hint">{{form.preparednessScore === 1 ? '刚收藏' : form.preparednessScore === 3 ? '简历已适配' : form.preparednessScore === 5 ? '内推已就绪' : ''}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="onSubmit" disabled="{{saving}}">
    {{saving ? '保存中...' : (isEdit ? '保存修改' : '添加岗位')}}
  </button>
</view>
