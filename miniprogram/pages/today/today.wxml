<!-- 日常 Tab v1.1 -->
<view class="page">
  <!-- 离线 -->
  <view wx:if="{{isOffline}}" class="offline-banner">当前离线，显示最近数据</view>

  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading}}" count="{{3}}" />

  <!-- 庆祝态 -->
  <view wx:elif="{{todayGenerated && allDone}}" class="celebration">
    <text class="celebration-icon">🎉</text>
    <text class="celebration-text">今日委托全部完成</text>
    <text class="celebration-sub">干得好！</text>
  </view>

  <!-- 引导态 -->
  <empty-state wx:elif="{{empty}}" text="还没有日常任务，去创建一个吧"
    showBtn="{{true}}" btnText="去创建" bind:action="onGoToCreate"/>

  <!-- 模块列表 -->
  <view wx:else class="module-list">
    <view class="date-header">
      <text class="date-text">{{todayDate}}</text>
    </view>

    <view wx:for="{{modules}}" wx:key="key"
      class="module module--{{item.key}} {{item.open ? 'open' : 'closed'}}">
      <!-- 模块头部 -->
      <view class="module-header" data-key="{{item.key}}" bindtap="onModuleToggle">
        <text class="module-icon" style="background:{{item.color}}15">{{item.icon}}</text>
        <text class="module-label">{{item.name}}</text>
        <text class="module-count">{{item.count}}</text>
        <text class="module-toggle">{{item.open ? '▾' : '▸'}}</text>
      </view>

      <!-- 折叠内容 -->
      <view wx:if="{{item.open}}" class="module-body">
        <view wx:for="{{item.actions}}" wx:key="_id" class="task-row">
          <view class="task-info">
            <text class="task-name">{{item.title}}</text>
            <text wx:if="{{item.description}}" class="task-hint">{{item.description}}</text>
          </view>
          <button class="btn-done" data-id="{{item._id}}" bindtap="onComplete">完成</button>
        </view>
      </view>
    </view>
  </view>
</view>
