<!-- 今日首页 -->
<view class="page">
  <!-- 骨架屏：加载中 -->
  <skeleton wx:if="{{loading}}" count="{{3}}" />

  <!-- 庆祝态：今日已生成且全部完成 -->
  <view wx:elif="{{todayGenerated && allDone && !showPostponeHint}}" class="celebration">
    <text class="celebration-icon">🎉</text>
    <text class="celebration-text">今日委托全部完成</text>
    <text class="celebration-sub">干得好！</text>
  </view>

  <!-- 引导态：从未生成过 -->
  <empty-state wx:elif="{{empty && !showPostponeHint}}" text="今日无任务，去添加一个目标吧"
               showBtn="{{true}}" btnText="去添加任务" bind:action="onGoToTasks"/>

  <!-- 频繁推迟提示 -->
  <empty-state wx:elif="{{showPostponeHint}}"
    text="今天的委托不太对？去委托页调整优先级或添加新任务吧"
    showBtn="{{true}}" btnText="去调整任务" bind:action="onGoToTasks"/>

  <!-- 行动卡片列表 -->
  <view wx:else class="action-list">
    <view class="date-header">
      <text class="date-text">{{todayDate}}</text>
      <text class="date-sub">今日 {{actions.length}} 项行动</text>
    </view>
    <action-card
      wx:for="{{actions}}"
      wx:key="_id"
      action="{{item}}"
      bind:complete="onComplete"
      bind:postpone="onPostpone"
    />
  </view>
</view>
