<!-- 推进 Tab v1.1 — 组件家族版 -->
<view class="page">
  <!-- 操作栏 -->
  <view class="topbar">
    <text class="back-btn" bindtap="onBack">← 日常</text>
    <view class="module-label" bindtap="onModuleLabelTap">
      <text>{{currentModuleInfo.icon}}</text>
      <text class="module-name">{{currentModuleInfo.name}}</text>
      <text class="dropdown">▾</text>
    </view>
    <text class="more-btn">⋯</text>
  </view>

  <!-- 数据概览：求职漏斗 -->
  <view wx:if="{{funnel}}" class="data-bar">
    <view class="funnel-row">
      <view class="funnel-item">
        <text class="funnel-num">{{funnel.pending}}</text>
        <text class="funnel-label">待投</text>
      </view>
      <text class="funnel-arrow">→</text>
      <view class="funnel-item">
        <text class="funnel-num">{{funnel.applied}}</text>
        <text class="funnel-label">已投</text>
      </view>
      <text class="funnel-arrow">→</text>
      <view class="funnel-item">
        <text class="funnel-num">{{funnel.interviewing}}</text>
        <text class="funnel-label">面试</text>
      </view>
      <text class="funnel-arrow">→</text>
      <view class="funnel-item">
        <text class="funnel-num funnel-highlight">{{funnel.offer}}</text>
        <text class="funnel-label">Offer</text>
      </view>
    </view>
  </view>

  <!-- 今日任务 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">今日任务</text>
      <text class="history-btn" bindtap="toggleHistory">{{showHistory ? '收起' : '📋 历史'}}</text>
      <text class="section-add" bindtap="onAddTask">+ 添加</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{isLoading}}" class="empty-hint">加载中...</view>

    <!-- 空数据 -->
    <view wx:elif="{{activeTasks.length === 0}}" class="empty-hint">今天还没有任务</view>

    <!-- 进行中卡片：按模块分发组件 -->
    <block wx:else>
      <block wx:if="{{currentModule === 'jobseeker'}}">
        <card-jobseeker
          wx:for="{{activeTasks}}" wx:key="_id"
          action="{{item}}" completed="{{false}}"
          bind:complete="onCardComplete"
          bind:tool="onCardTool"
          bind:nav="onCardNav"
        />
      </block>
      <block wx:else>
        <card-default
          wx:for="{{activeTasks}}" wx:key="_id"
          action="{{item}}" completed="{{false}}"
          bind:complete="onCardComplete"
          bind:edit="onCardEdit"
        />
      </block>
    </block>
  </view>

  <!-- 已完成折叠区 -->
  <view wx:if="{{showHistory}}" class="section">
    <view class="section-header">
      <text class="section-title">今日已完成</text>
    </view>

    <view wx:if="{{completedTasks.length === 0}}" class="empty-hint">暂无已完成任务</view>

    <block wx:else>
      <block wx:if="{{currentModule === 'jobseeker'}}">
        <card-jobseeker
          wx:for="{{completedTasks}}" wx:key="_id"
          action="{{item}}" completed="{{true}}"
          bind:nav="onCardNav"
        />
      </block>
      <block wx:else>
        <card-default
          wx:for="{{completedTasks}}" wx:key="_id"
          action="{{item}}" completed="{{true}}"
        />
        <!-- 已完成卡片操作按钮 -->
        <view wx:for="{{completedTasks}}" wx:key="_id" class="completed-ops">
          <text class="redo-btn" data-id="{{item._id}}" data-source="{{item.sourceId}}" bindtap="onRedo">再做一次</text>
          <text class="delete-btn" data-id="{{item._id}}" data-source="{{item.sourceId}}" bindtap="onDeleteCompleted">删除</text>
        </view>
      </block>
    </block>
  </view>

  <!-- 工具箱 -->
  <view class="section">
    <text class="section-title">工具箱</text>

    <!-- 模块配置驱动：显示上限滑块 -->
    <block wx:if="{{showLimitSlider}}">
      <view class="tool-card">
        <text class="tool-label">{{limitLabel}}</text>
        <slider min="{{limitMin}}" max="{{limitMax}}" value="{{dailyLimit}}" show-value block-size="16"
                activeColor="#D97706" bindchange="onDailyLimitChange" style="width:60%"/>
      </view>
    </block>
    <!-- 求职模块专属：岗位管理 -->
    <view class="tool-card tool-card--action" bindtap="onGoJobs" wx:if="{{currentModule === 'jobseeker'}}">
      <text class="tool-icon">📋</text>
      <view class="tool-info">
        <text class="tool-name">岗位管理</text>
        <text class="tool-desc">查看、筛选、推进所有岗位</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>

    <!-- 非求职模块：任务管理 -->
    <view class="tool-card tool-card--action" bindtap="onGoTasks" wx:if="{{currentModule !== 'jobseeker'}}">
      <text class="tool-icon">📝</text>
      <view class="tool-info">
        <text class="tool-name">任务管理</text>
        <text class="tool-desc">查看、编辑、管理所有任务</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>
  </view>
</view>

<!-- 模块切换弹窗 -->
<view wx:if="{{showSheet}}" class="sheet-mask" bindtap="closeSheet"></view>
<view class="sheet {{showSheet ? 'sheet--show' : ''}}">
  <view class="sheet-title">切换模块</view>
  <view wx:for="{{modules}}" wx:key="key" class="sheet-item" data-key="{{item.key}}" bindtap="onModuleSelect">
    <text>{{item.icon}} {{item.name}}</text>
    <text wx:if="{{item.key === currentModule}}" style="color:var(--color-primary)">✓</text>
  </view>
  <view class="sheet-cancel" bindtap="closeSheet">取消</view>
</view>
