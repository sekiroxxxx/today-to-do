.page { min-height: 100vh; background: var(--color-bg); }

/* 操作栏 */
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 14px var(--spacing-md); border-bottom: 1px solid var(--color-border); background: var(--color-bg); }
.back-btn { font-size: var(--font-caption); color: var(--color-text-secondary); }
.module-label { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; color: var(--color-text); }
.module-name { margin: 0 2px; }
.dropdown { font-size: 10px; color: var(--color-text-hint); }
.more-btn { font-size: 18px; color: var(--color-text-secondary); padding: 0 4px; letter-spacing: 2px; }

/* 数据概览 */
.data-bar { padding: var(--spacing-md); display: flex; justify-content: center; }
.funnel-row { display: flex; align-items: center; gap: 12px; background: var(--color-primary-light); border: 1px solid #EDE0CC; border-radius: 10px; padding: 14px 20px; }
.funnel-item { text-align: center; }
.funnel-num { font-size: 20px; font-weight: 700; color: var(--color-text); }
.funnel-highlight { color: var(--color-primary); }
.funnel-label { font-size: 10px; color: var(--color-text-hint); display: block; }
.funnel-arrow { color: #D0C4A5; font-size: 12px; }

/* 分区 */
.section { padding: 0 var(--spacing-md); }
.section-header { display: flex; align-items: center; padding: var(--spacing-xs) 0 var(--spacing-sm); }
.section-title { font-size: 14px; font-weight: 600; color: var(--color-text); }
.section-add { font-size: var(--font-caption); color: var(--color-primary); margin-left: auto; }
.history-btn { font-size: var(--font-caption); color: var(--color-text-secondary); margin-left: var(--spacing-sm); padding: 2px 8px; }

/* 空数据 */
.empty-hint { text-align: center; padding: var(--spacing-lg); color: var(--color-text-hint); font-size: var(--font-caption); }

/* 已完成面板操作按钮 */
.completed-ops { display: flex; justify-content: flex-end; gap: var(--spacing-md); padding: 0 var(--spacing-sm) var(--spacing-sm); margin-top: -6px; }
.redo-btn { font-size: var(--font-tag); color: var(--color-primary); padding: 4px 0; }
.delete-btn { font-size: var(--font-tag); color: #FF4D4F; padding: 4px 0; }

/* 工具箱 */
.tool-card { background: #fff; border: 1px solid var(--color-border); border-radius: 10px;
  padding: 14px; margin-bottom: 10px; }
.tool-card--action { display: flex; align-items: center; gap: 12px; }
.tool-icon { font-size: 24px; }
.tool-info { flex: 1; }
.tool-name { font-size: 14px; font-weight: 500; }
.tool-desc { font-size: var(--font-tag); color: var(--color-text-hint); }
.tool-arrow { font-size: 18px; color: #CCC; }
.tool-label { font-size: 14px; margin-bottom: 4px; }

/* 切换弹窗 */
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(60,36,21,0.3); z-index: 50; }
.sheet { position: fixed; bottom: 0; left: 0; right: 0; z-index: 51; background: var(--color-bg); border-radius: 16px 16px 0 0; padding: var(--spacing-md); transform: translateY(100%); transition: transform 0.3s; }
.sheet--show { transform: translateY(0); }
.sheet-title { font-size: 15px; font-weight: 600; color: var(--color-text); text-align: center; padding-bottom: 12px; border-bottom: 1px solid var(--color-border); margin-bottom: 8px; }
.sheet-item { display: flex; justify-content: space-between; padding: var(--spacing-sm) 0; font-size: var(--font-body); }
.sheet-cancel { text-align: center; padding: var(--spacing-sm); margin-top: 8px; color: var(--color-text-hint); border-top: 1px solid var(--color-border); }
