<!-- module-task: 配置驱动的通用任务卡片 -->
<view class="card {{completed ? 'card--done' : ''}}">
  <!-- 头部：标题 + 完成状态 -->
  <view class="card-header">
    <text class="card-title text-ellipsis">{{title}}</text>
    <text wx:if="{{completed}}" class="done-mark">✓</text>
  </view>

  <!-- 描述 -->
  <text wx:if="{{description}}" class="card-desc">{{description}}</text>

  <!-- 徽章行 -->
  <view wx:if="{{badges.length > 0}}" class="badge-row">
    <text wx:for="{{badges}}" wx:key="text" class="badge-item"
          style="color:{{item.color}};background:{{item.bg}}">{{item.text}}</text>
  </view>

  <!-- 副信息行 -->
  <view wx:if="{{meta.length > 0}}" class="meta-row">
    <text wx:for="{{meta}}" wx:key="label" class="meta-item">{{item.label}}: {{item.value}}</text>
  </view>

  <!-- 操作按钮 -->
  <view wx:if="{{actions.length > 0 && !completed}}" class="action-row">
    <button wx:for="{{actions}}" wx:key="key"
      class="action-btn {{item.type === 'primary' ? 'action-btn--primary' : ''}}"
      data-key="{{item.key}}" bindtap="onAction">{{item.text}}</button>
  </view>

  <!-- 简单完成按钮 -->
  <view wx:if="{{taskType === 'simple' && !completed}}" class="complete-row">
    <button class="action-btn action-btn--primary" bindtap="onComplete">完成</button>
  </view>
</view>
