/* 通用底部弹窗 — 复用和 action-card 内嵌弹窗相同的样式 */
.sheet-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 100;
}
.sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 101;
  background: #fff; border-radius: 16px 16px 0 0;
  padding: var(--spacing-md);
  transform: translateY(100%); transition: transform 0.3s;
}
.sheet--show { transform: translateY(0); }
.sheet-header {
  font-size: var(--font-body); font-weight: 600;
  text-align: center; padding-bottom: var(--spacing-sm);
  border-bottom: 1px solid var(--color-border); margin-bottom: var(--spacing-xs);
}
.sheet-item {
  padding: var(--spacing-sm) 0; border-bottom: 1px solid #FAFAFA;
}
.sheet-item-label { font-size: var(--font-body); }
.sheet-item-label--danger { color: var(--color-danger); }
.sheet-item-desc { font-size: var(--font-caption); color: var(--color-text-hint); display: block; }
.sheet-cancel {
  text-align: center; padding: var(--spacing-sm); margin-top: var(--spacing-xs);
  color: var(--color-text-hint); font-size: var(--font-body);
  border-top: 1px solid var(--color-border);
}
