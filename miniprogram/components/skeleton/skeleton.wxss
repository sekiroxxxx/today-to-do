/* 骨架屏 */
.sk-card {
  background: #fff; border-radius: var(--radius-md);
  padding: var(--spacing-md); margin-bottom: var(--spacing-sm);
}
.sk-row { display: flex; align-items: center; gap: var(--spacing-xs); margin-bottom: var(--spacing-sm); }
.sk-tag { width: 40px; height: 18px; background: #F0F0F0; border-radius: 4px; }
.sk-title { width: 120px; height: 18px; background: #F0F0F0; border-radius: 4px; }
.sk-desc { width: 100%; height: 14px; background: #F0F0F0; border-radius: 4px; margin-bottom: var(--spacing-xs); }
.sk-desc--short { width: 60%; }
.sk-footer { padding-top: var(--spacing-xs); }
.sk-score { width: 80px; height: 12px; background: #F0F0F0; border-radius: 2px; }
.sk-btns { display: flex; gap: var(--spacing-xs); }
.sk-btn { width: 52px; height: 28px; background: #F0F0F0; border-radius: 14px; }

/* 呼吸动画 */
.sk-card view {
  animation: sk-shimmer 1.5s ease-in-out infinite;
}
@keyframes sk-shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
