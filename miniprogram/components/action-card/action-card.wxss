/* 卡片主体 */
.card {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-card);
  transition: all 0.3s ease;
}
.card--completing { opacity: 0.6; transform: scale(0.97); }
.card--removed { opacity: 0; height: 0; padding: 0; margin: 0; overflow: hidden; }

/* 头部：标签 + 标题 + 分数徽章 */
.card-header { display: flex; align-items: center; margin-bottom: var(--spacing-sm); }
.card-title { font-size: var(--font-body); font-weight: 600; margin-left: var(--spacing-xs); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 分数小徽章 */
.score-badge {
  font-size: var(--font-tag);
  color: var(--color-primary);
  font-weight: 600;
  background: var(--color-primary-light);
  padding: 2px 8px;
  border-radius: var(--radius-round);
  margin-left: var(--spacing-xs);
  flex-shrink: 0;
}

/* 标签 */
.tag { font-size: var(--font-tag); padding: 2px 10px; border-radius: var(--radius-round); }
.tag--custom { background: #F0F0F0; color: var(--color-text-secondary); }

/* 描述 */
.card-body { margin-bottom: var(--spacing-sm); }
.card-desc { font-size: var(--font-caption); color: var(--color-text-secondary); }

/* 底部按钮行 */
.card-footer {
  display: flex; gap: var(--spacing-sm); padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
}
.btn {
  flex: 1;
  padding: 8px 0;
  font-size: var(--font-body);
  border-radius: var(--radius-sm);
  border: none;
  line-height: 1.5;
  display: flex; align-items: center; justify-content: center;
}
.btn--complete { background: var(--color-primary); color: #fff; }
.btn--postpone { background: var(--color-bg); color: var(--color-text-secondary); }
.btn[disabled] { opacity: 0.5; }

/* 底部弹窗 */
.sheet-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 100;
}
.sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 101;
  background: #fff; border-radius: 16px 16px 0 0;
  padding: var(--spacing-md);
  transform: translateY(100%); transition: transform 0.3s;
}
.sheet--show { transform: translateY(0); }
.sheet-header {
  font-size: var(--font-body); font-weight: 600;
  text-align: center; padding-bottom: var(--spacing-sm);
  border-bottom: 1px solid var(--color-border); margin-bottom: var(--spacing-xs);
}
.sheet-item {
  display: flex; align-items: center; gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
}
.sheet-item-icon { font-size: 24px; width: 40px; text-align: center; }
.sheet-item-title { font-size: var(--font-body); display: block; }
.sheet-item-desc { font-size: var(--font-caption); color: var(--color-text-hint); }
.sheet-cancel {
  text-align: center; padding: var(--spacing-sm);
  color: var(--color-text-hint); font-size: var(--font-body);
  border-top: 1px solid var(--color-border); margin-top: var(--spacing-xs);
}
