<!-- 行动卡片 -->
<view class="card {{removed ? 'card--removed' : ''}} {{completing ? 'card--completing' : ''}}">
  <!-- 头部：标签 + 标题 + 分数 -->
  <view class="card-header">
    <status-tag
      wx:if="{{action.sourceType === 'job'}}"
      status="{{action.sourceType}}"
      text="求职"
    />
    <view wx:else class="tag tag--custom">自定义</view>
    <text class="card-title text-ellipsis">{{action.title}}</text>
    <text wx:if="{{action.normalizedScore >= 80}}" class="badge badge--s">S</text>
    <text wx:elif="{{action.normalizedScore >= 50}}" class="badge badge--a">A</text>
    <text wx:elif="{{action.normalizedScore >= 30}}" class="badge badge--b">B</text>
    <text wx:else class="badge badge--c">C</text>
  </view>

  <!-- 描述 -->
  <view class="card-body">
    <text class="card-desc">{{action.description || '暂无描述'}}</text>
  </view>

  <!-- 底部：两个等宽按钮 -->
  <view class="card-footer">
    <button class="btn btn--complete" bindtap="onTapComplete" disabled="{{completing || postponing}}">
      {{completing ? '...' : '✅ 完成'}}
    </button>
    <button class="btn btn--postpone" bindtap="onTapPostpone" disabled="{{completing || postponing}}">
      {{postponing ? '...' : '⏳ 推迟'}}
    </button>
  </view>
</view>

<!-- 推迟方式选择弹窗 -->
<view class="sheet-mask" wx:if="{{showPostponeSheet}}" bindtap="closeSheet"></view>
<view class="sheet {{showPostponeSheet ? 'sheet--show' : ''}}">
  <view class="sheet-header">选择推迟方式</view>
  <view class="sheet-item" data-type="later" bindtap="onPostponeSelect">
    <view class="sheet-item-icon">🔔</view>
    <view class="sheet-item-content">
      <text class="sheet-item-title">稍后提醒</text>
      <text class="sheet-item-desc">今天晚些时候再次出现</text>
    </view>
  </view>
  <view class="sheet-item" data-type="skip" bindtap="onPostponeSelect">
    <view class="sheet-item-icon">⏭</view>
    <view class="sheet-item-content">
      <text class="sheet-item-title">跳过今天</text>
      <text class="sheet-item-desc">明天再处理，会影响排序优先级</text>
    </view>
  </view>
  <view class="sheet-cancel" bindtap="closeSheet">取消</view>
</view>
