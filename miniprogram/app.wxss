/* ============================================
   刷日常 v1.1 — 暖色系全局样式
   ============================================ */

page {
  --color-primary: #D97706;
  --color-primary-light: #FFFBF5;
  --color-success: #65A30D;
  --color-warning: #D97706;
  --color-danger: #DC2626;
  --color-text: #3C2415;
  --color-text-secondary: #8B7355;
  --color-text-hint: #B8A590;
  --color-border: #EDE8DF;
  --color-bg: #FBFAF7;
  --color-white: #FFFFFF;
  --color-tag-pending: #D97706;
  --color-tag-applied: #CA8A04;
  --color-tag-interview: #65A30D;
  --color-tag-offer: #7C3AED;
  --color-tag-rejected: #B8A590;

  --font-title: 18px;
  --font-body: 15px;
  --font-caption: 13px;
  --font-tag: 11px;

  --spacing-xs: 8px;
  --spacing-sm: 12px;
  --spacing-md: 16px;
  --spacing-lg: 20px;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-round: 999px;

  --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.06);

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--font-body);
  color: var(--color-text);
  line-height: 1.5;
}

/* 通用弹性布局 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* 文字截断 */
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 显隐工具类（替代 wx:if，0ms 切换） */
.hidden { display: none !important; }
.fade { opacity: 0; pointer-events: none; transition: opacity 0.2s; }
.fade--in { opacity: 1; pointer-events: auto; }
